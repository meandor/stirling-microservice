{
  "name": "meandor/stirling-microservice",
  "description": "A PHP Microservice framework. This can be used as a dependency for commonly used functionalities in a microservice.",
  "type": "library",
  "homepage": "https://github.com/meandor/stirling-microservice",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Schruhl",
      "email": "danielschruhl@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "Stirling\\": "src/"
    }
  }
}
