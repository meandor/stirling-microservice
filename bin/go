#!/usr/bin/env bash
# Find project root
PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

goal_test() {
  ${PROJECT_ROOT}/vendor/bin/phpunit --colors=always ${PROJECT_ROOT}/tests
}

goal_complexity() {
  ${PROJECT_ROOT}/vendor/bin/phpmd analyze --format github --ruleset ${PROJECT_ROOT}/phpmd-complexity.xml src
}

goal_mutation() {
  ${PROJECT_ROOT}/vendor/bin/infection --no-interaction --threads=1
}

goal_mutation_check() {
  ${PROJECT_ROOT}/vendor/bin/infection --no-interaction --threads=1 --min-msi=90 --min-covered-msi=90
}

goal_lint_check() {
  ${PROJECT_ROOT}/vendor/bin/php-cs-fixer check
}

goal_lint_fix() {
  ${PROJECT_ROOT}/vendor/bin/php-cs-fixer fix
}

goal_check() {
  echo "Running lint-check..."
  goal_lint_check || return $?
  echo "Running static-analysis..."
  goal_static_analysis || return $?
  echo "Running test..."
  goal_test || return $?
  echo "Running mutation-check..."
  goal_mutation_check || return $?
  echo "Running complexity..."
  goal_complexity || return $?
  echo "Running security-check..."
  goal_security_check || return $?
}

goal_static_analysis() {
  ${PROJECT_ROOT}/vendor/bin/phpstan analyse --no-progress --configuration ${PROJECT_ROOT}/phpstan.neon.dist
}

goal_security_check() {
  docker run --rm --volume "$(pwd):/app" --volume /var-run/docker.sock:/var-run/docker.sock aquasec/trivy:latest fs --scanners vuln,secret,misconfig --include-dev-deps --no-progress /app/composer.lock
}

function help {
    echo "usage: $0 <task>
task can be:
    help             -- This help message
    install          -- Installs all dependencies
    test             -- Runs all tests
    complexity         -- Checks cyclomatic complexity
    mutation         -- Runs mutation tests with Infection (xdebug for coverage)
    mutation-check    -- Runs mutation tests with 90% MSI threshold
    security-check   -- Scans code and dependencies (via Docker)
    lint-check       -- Checks code style (no changes)
    lint             -- Fixes code style (auto-fix)
    static-analysis  -- Statically checks the code with PHPStan (level 4)
    check            -- Runs lint-check, static-analysis, security-check and unit tests
                     -- Anything else accepted by composer
         "
}

if [ "$1" == "help" ]; then
    help
elif [ "$1" == "test" ]; then
    goal_test
elif [ "$1" == "complexity" ]; then
    goal_complexity
elif [ "$1" == "mutation" ]; then
    goal_mutation
elif [ "$1" == "mutation-check" ]; then
    goal_mutation_check
elif [ "$1" == "security-check" ]; then
    goal_security_check
elif [ "$1" == "static-analysis" ]; then
    goal_static_analysis
elif [ "$1" == "lint-check" ]; then
    goal_lint_check
elif [ "$1" == "lint" ]; then
    goal_lint_fix
elif [ "$1" == "check" ]; then
    goal_check
else
    php ${PROJECT_ROOT}/bin/composer.phar $*
fi
